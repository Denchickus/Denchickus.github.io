---
/**
 * Homepage прототипа СТ-ТЕХНИКС.
 * Реализованы ровно 7 утверждённых секций из SITE_STRUCTURE.md §5.
 * Ни одного блока-обещания, ни одной выдуманной цифры, ни клиентов/отзывов/
 * сертификатов/статистики опыта — таких данных в инвентаре нет.
 */
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import CategoryCard from '../components/CategoryCard.astro';
import MachineTypeCard from '../components/MachineTypeCard.astro';
import ProductCard from '../components/ProductCard.astro';

import {
  getCategories,
  getVisibleMachineTypes,
  getHomepageProducts,
  getProductTotal,
} from '../data/catalog';
import {
  BRAND,
  HOME_H1_SOURCE,
  TRUST_FACTS,
  CONTACTS,
  telHref,
} from '../data/site';
import { pluralPozitsiya, pluralTip } from '../data/plural';
import { getHeroImage } from '../data/productImages';

const categories = getCategories();
const machineTypes = getVisibleMachineTypes();
const products = getHomepageProducts(8);
const total = getProductTotal();

// Блок «Почему СТ-ТЕХНИКС» — только 4 самых сильных подтверждённых факта.
const whyFacts = TRUST_FACTS.filter((f) => f.home);
// Основной телефон для CTA (полный список — в футере).
const primaryPhone = CONTACTS.phones[0];

// Реальное Hero-изображение используется только если оно VERIFIED. Сейчас
// подтверждённого нет -> getHeroImage() === null -> техническая заглушка.
const heroImage = getHeroImage();
---

<Base
  title=""
  description="Завод собственного производства навесного оборудования на спецтехнику. Ковши, отвалы, щётки, захваты, вилы и другое оборудование для погрузчиков и тракторов. Поставка напрямую от производителя."
>
  {/* --- 1. HERO --------------------------------------------------------- */}
  <section class="section hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="hero__eyebrow">{BRAND.tagline}</p>
        {/*
          Desktop и mobile — РАЗНЫЕ <h1>, не одна строка с CSS-переносами: сокращённый
          desktop-заголовок «съеденный» переносами давал 5–6 рваных строк на 360–390px,
          этого добивались отдельной формулировкой. Виден в каждый момент только один —
          скрытый по display:none полностью выпадает из a11y-дерева, поэтому на странице
          остаётся ровно один H1, экспонированный вспомогательным технологиям, в любой
          ширине viewport. Desktop-текст и его подача не менялись.
          Оба варианта — редактура уже подтверждённых фактов (BRAND.name, total,
          machineTypes.length), новых бизнес-фактов не добавлено.
        */}
        <h1 class="hero__h1 hero__h1--desktop">{HOME_H1_SOURCE}</h1>
        <h1 class="hero__h1 hero__h1--mobile">{BRAND.name} — навесное оборудование для спецтехники</h1>
        <p class="hero__lead hero__lead--full">
          Каталог из {total} {pluralPozitsiya(total)} навесного оборудования для
          {' '}{machineTypes.length} {pluralTip(machineTypes.length)} спецтехники. Цены — напрямую от производителя.
        </p>
        <p class="hero__lead hero__lead--short">
          Собственное производство. {total} {pluralPozitsiya(total)} для {machineTypes.length}
          {' '}{pluralTip(machineTypes.length)} техники. Цены напрямую от производителя.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/catalog">Перейти в каталог</a>
          <a class="btn btn--secondary" href="/machines">Подобрать по типу техники</a>
        </div>
      </div>
      <div class="hero__media">
        {heroImage && heroImage.localPath ? (
          <figure class="hero__showcase">
            <img
              class="hero__showcase-img"
              src={heroImage.localPath}
              alt={heroImage.alt ?? 'Навесное оборудование СТ-ТЕХНИКС'}
              width={heroImage.width ?? undefined}
              height={heroImage.height ?? undefined}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              style={`object-fit: ${heroImage.fit ?? 'contain'}; object-position: ${heroImage.objectPosition ?? 'center'};`}
            />
          </figure>
        ) : (
          <Placeholder ratio="4 / 3" label="Фото оборудования" />
        )}
      </div>
    </div>
  </section>

  {/* --- 2. ДВА ВХОДА -------------------------------------------------- */}
  <section class="section" aria-labelledby="entries-h">
    <div class="container">
      <div class="section-head">
        <h2 id="entries-h">Найдите оборудование</h2>
      </div>
      <div class="entries">
        <a class="card card--link entry" href="/catalog">
          <span class="entry__title">Каталог оборудования</span>
          <span class="entry__meta tnum">{total} {pluralPozitsiya(total)}</span>
          <span class="entry__desc text-muted">
            Весь ассортимент с фильтрами по категории, технике и цене.
          </span>
          <span class="entry__go">Открыть каталог →</span>
        </a>
        <a class="card card--link entry" href="/machines">
          <span class="entry__title">Подбор по типу техники</span>
          <span class="entry__meta tnum">{machineTypes.length} {pluralTip(machineTypes.length)}</span>
          <span class="entry__desc text-muted">
            Выберите вашу технику — покажем совместимое оборудование.
          </span>
          <span class="entry__go">Выбрать технику →</span>
        </a>
      </div>
    </div>
  </section>

  {/* --- 3. КАТЕГОРИИ ------------------------------------------------- */}
  <section class="section" aria-labelledby="cats-h">
    <div class="container">
      <div class="section-head">
        <h2 id="cats-h">Категории оборудования</h2>
      </div>
      <div class="card-grid card-grid--tiles card-grid--categories">
        {categories.map((category) => <CategoryCard category={category} />)}
      </div>
    </div>
  </section>

  {/* --- 4. ТИПЫ ТЕХНИКИ -------------------------------------------- */}
  <section class="section" aria-labelledby="mts-h">
    <div class="container">
      <div class="section-head">
        <h2 id="mts-h">Подбор по типу техники</h2>
        <p class="text-muted">Выберите вашу технику — покажем совместимое оборудование.</p>
      </div>
      <div class="card-grid card-grid--tiles">
        {machineTypes.map((machineType) => <MachineTypeCard machineType={machineType} />)}
      </div>
    </div>
  </section>

  {/* --- 5. ОБОРУДОВАНИЕ ------------------------------------------- */}
  <section class="section" aria-labelledby="equip-h">
    <div class="container">
      <div class="section-head section-head--row">
        <h2 id="equip-h">Навесное оборудование</h2>
        <a class="btn btn--secondary" href="/catalog">
          Всё оборудование — {total}
        </a>
      </div>
      <div class="card-grid card-grid--products">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  {/* --- 6. РЕЕСТР ФАКТОВ ------------------------------------------ */}
  <section class="register" aria-labelledby="why-h">
    <div class="container">
      <h2 id="why-h" class="register__label">Почему СТ-ТЕХНИКС</h2>
      <ul role="list" class="register__rows">
        {whyFacts.map((fact, i) => (
          <li class="register__row">
            <span class="register__index tnum" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="register__title">{fact.title}</h3>
            <p class="register__text">{fact.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* --- 7. CONTACT — компактный светлый CTA перед футером ------- */}
  <section class="contact" aria-labelledby="contact-h">
    <div class="container">
      <div class="contact__inner">
        <div class="contact__left">
          <h2 id="contact-h" class="contact__title">Есть вопрос по оборудованию?</h2>
          <p class="contact__text">
            Поможем подобрать подходящий вариант и ответим на вопросы по цене и доставке.
          </p>
        </div>
        <div class="contact__right">
          <a class="contact__phone tnum" href={telHref(primaryPhone)}>{primaryPhone}</a>
          <button type="button" class="btn btn--primary" data-open-request-modal>Задать вопрос</button>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* --- Hero ---------------------------------------------------------- */
  /* Заголовочная гарнитура Hero — редакционный гротеск нормальной ширины.
     Golos Text используется, если добавлен локально; иначе Inter / системный
     гротеск. Внешние CDN не подключаются. */
  .hero {
    --font-hero: "Golos Text", "Inter", system-ui, -apple-system, "Segoe UI",
      Roboto, "Helvetica Neue", Arial, sans-serif;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 54fr) minmax(0, 42fr);
    justify-content: space-between;
    column-gap: clamp(48px, 7vw, 120px);
    align-items: center;
  }
  .hero__text {
    max-width: 40rem;
  }
  .hero__eyebrow {
    font-family: var(--font-hero);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted); /* fallback */
    color: color-mix(in srgb, var(--accent) 60%, var(--text-muted));
    margin-bottom: var(--space-3);
  }
  .hero__h1 {
    margin: 0;
  }
  .hero__text .hero__h1--desktop {
    font-family: var(--font-hero);
    font-size: clamp(2rem, 1.15rem + 2.6vw, 2.75rem);
    line-height: 1.07;
    letter-spacing: -0.02em;
    font-weight: 800;
    max-width: 24ch;
    text-wrap: balance;
  }
  /* Скрыт по умолчанию (desktop/tablet) — виден только в mobile media ниже. */
  .hero__h1--mobile {
    display: none;
  }
  .hero__lead {
    margin-top: var(--space-8);
    max-width: 46ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .hero__lead--short {
    display: none; /* показывается только на мобильном, см. media ниже */
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-12);
  }
  /* secondary в Hero не перетягивает внимание с primary */
  .hero__actions .btn--secondary {
    border-color: var(--line);
    color: var(--text);
  }
  .hero__actions .btn--secondary:hover {
    border-color: var(--text-muted);
  }

  /* Hero media — часть композиции страницы, БЕЗ рамки/подложки/тени/карточки */
  .hero__showcase {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero__showcase-img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    /* оборудование занимает бóльшую часть media area, но не касается краёв */
    max-height: min(42vh, 400px);
    margin-inline: auto;
  }

  /* --- Два входа --------------------------------------------------- */
  .entries {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gutter);
  }
  .entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-12);
  }
  .entry__kicker {
    font-family: var(--font-display);
    font-size: var(--fs-small);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .entry__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-h3);
  }
  .entry__meta {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--accent);
  }
  .entry__desc {
    max-width: 40ch;
  }
  .entry__go {
    margin-top: var(--space-4);
    font-weight: 600;
  }
  .entry:hover .entry__go {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* --- Плитки категорий / типов ------------------------------- */
  .card-grid--tiles {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  @media (max-width: 1024px) {
    .card-grid--tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 768px) {
    .card-grid--tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Плотность плиток категорий/типов техники на mobile — компактнее, чем
     базовый --grid-gutter (используется и другими сетками, его не трогаем). */
  @media (max-width: 768px) {
    .card-grid--categories {
      gap: 11px;
    }
  }
  /* Только категории (не типы техники, у них другой формат карточки —
     MachineTypeCard.astro — и своего overflow-риска на 2 колонках нет):
     на самых узких экранах 2 колонки не оставляют строке заголовок+счётчик
     достаточно места даже после переноса — переходим в 1 колонку. Плитки стали
     компактнее (CategoryCard.astro), поэтому порог сдвинут с 420 на 340px —
     2 колонки теперь помещаются комфортно дальше вниз по ширине. */
  @media (max-width: 340px) {
    .card-grid--categories {
      grid-template-columns: 1fr;
    }
    /* Тот же принцип для плиток типов техники (используют общий класс
       .card-grid--tiles с категориями) — на самых узких экранах тоже 1 колонка. */
    .card-grid--tiles {
      grid-template-columns: 1fr;
    }
  }

  /* --- Секция «Оборудование»: 4 / 2 / 1 колонки --------------- */
  .card-grid--products {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  @media (max-width: 1199px) {
    .card-grid--products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .card-grid--products {
      grid-template-columns: 1fr;
    }
  }

  .section-head--row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
  }
  .section-head--row p {
    margin-top: var(--space-2);
    max-width: 52ch;
  }

  /* --- Реестр фактов «Почему СТ-ТЕХНИКС»: строки, не карточки --- */
  /* Variant A «РЕЕСТР» — docs/plans, art-direction review. Только
     глобальные --font-display / --font-text, локальной font-system нет. */
  .register {
    padding-block: clamp(64px, 8vw, 96px) clamp(48px, 6vw, 64px);
  }
  .register__label {
    margin: 0 0 clamp(32px, 4vw, 40px);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.45rem + 1.1vw, 2rem); /* 28–32px */
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .register__rows {
    display: block;
  }
  .register__row {
    display: grid;
    grid-template-columns: clamp(48px, 4vw, 56px) minmax(260px, 300px) minmax(0, 1fr);
    column-gap: var(--space-8);
    align-items: baseline;
    padding-block: clamp(20px, 2vw, 22px);
    border-top: 1px solid var(--line);
  }
  .register__row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .register__index {
    font-family: var(--font-display);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--accent);
  }
  .register__title {
    font-family: var(--font-display);
    font-size: 1.25rem; /* 20px */
    font-weight: 600;
    line-height: 1.3;
  }
  .register__text {
    font-family: var(--font-text);
    font-weight: 400;
    font-size: clamp(0.9375rem, 0.88rem + 0.25vw, 1rem); /* 15–16px */
    line-height: 1.5;
    color: var(--text-muted);
  }
  @media (max-width: 1024px) {
    .register__row {
      grid-template-columns: 48px minmax(220px, 260px) minmax(0, 1fr);
      column-gap: var(--space-6);
    }
  }
  @media (max-width: 768px) {
    .register__label {
      font-size: clamp(1.375rem, 5.5vw, 1.625rem); /* 22–26px */
    }
    .register__row {
      grid-template-columns: auto 1fr;
      column-gap: var(--space-4);
      row-gap: var(--space-1);
      padding-block: 16px; /* было clamp(20px,2vw,22px) */
    }
    .register__index {
      font-size: 0.8125rem; /* 13px — было var(--fs-small)=14px */
    }
    .register__title {
      font-size: 15px; /* было 17px */
      line-height: 1.3;
    }
    .register__text {
      grid-column: 1 / -1;
      font-size: 0.875rem; /* 14px — было 15px */
      line-height: 1.5;
    }
  }

  /* --- Contact: компактная светлая секция перед футером --------- */
  /* Variant заменяет отклонённую тёмную .closing целиком — новая
     композиция, не косметическая правка. Единственная тёмная зона на
     странице снова только Footer. */
  .contact {
    background: var(--bg-muted);
    border-top: 1px solid var(--line);
  }
  /* Единая типографика этой секции — Inter/системный гротеск, БЕЗ узкого
     --font-display (Arial Narrow-фолбэк не подходит крупному H2 и телефону).
     Локальной font-переменной не заводим: --font-text уже начинается с
     Inter, поэтому используем его. */
  .contact__inner {
    max-width: 1100px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    column-gap: clamp(64px, 6vw, 80px);
    align-items: center;
    padding-block: clamp(56px, 6vw, 64px);
  }
  .contact__title {
    margin: 0;
    font-family: var(--font-text);
    font-size: clamp(2.125rem, 1.7rem + 1.4vw, 2.25rem); /* 34–36px */
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 19ch;
  }
  .contact__text {
    margin: clamp(12px, 1.5vw, 16px) 0 0;
    font-family: var(--font-text);
    font-size: 1.0625rem; /* 17px */
    line-height: 1.55;
    max-width: 46ch;
    color: var(--text-muted);
  }
  .contact__right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .contact__phone {
    margin-bottom: 16px;
    font-family: var(--font-text);
    font-size: 1.5rem; /* 24px */
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .contact__phone:hover {
    color: var(--accent);
  }
  .contact__right .btn {
    font-family: var(--font-text);
    font-weight: 600;
  }
  @media (max-width: 768px) {
    .contact__inner {
      grid-template-columns: 1fr;
      row-gap: var(--space-8);
    }
    .contact__title {
      max-width: none;
    }
    .contact__right {
      align-items: stretch;
    }
    .contact__right .btn {
      width: 100%;
      text-align: center;
    }
  }

  /* --- Адаптив hero / входов --------------------------------- */
  @media (max-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 58fr) minmax(0, 40fr);
      column-gap: clamp(32px, 5vw, 72px);
    }
  }
  @media (max-width: 768px) {
    .hero.section {
      /* .section{padding-block:...} — та же специфичность у padding-top/padding-block
         на одном элементе; .hero.section даёт более высокую специфичность и
         гарантированно перебивает верхний отступ независимо от порядка в бандле
         (тот же приём, что уже применялся для .section.why). */
      padding-top: clamp(28px, 7vw, 36px);
      /* было --section-y (48px, унаследовано от .section) — следующий H2 начинался
         слишком поздно; .section + .section{padding-top:0} у соседней секции уже
         обнуляет её верхний отступ, поэтому весь зазор до H2 — это именно нижний
         отступ Hero. */
      padding-bottom: clamp(20px, 5vw, 28px);
    }
    .hero__grid {
      grid-template-columns: 1fr;
      /* было var(--space-8)=32px — картинка теперь ближе к CTA */
      row-gap: var(--space-4);
    }
    /* изображение — ПОСЛЕ текста (порядок DOM), без order-переопределения */
    .hero__text {
      max-width: none;
    }
    /* eyebrow снят с первого экрана ради плотности — из DOM/desktop не убирался */
    .hero__eyebrow {
      display: none;
    }
    /* Отдельный короткий mobile-заголовок вместо переноса длинного desktop H1 —
       переносами строк на узкой колонке не удавалось получить компактный результат:
       5–6 рваных строк вместо ~3–4 полных. */
    .hero__text .hero__h1--desktop {
      display: none;
    }
    .hero__text .hero__h1--mobile {
      display: block;
